# Build-only template. Supply private values outside the repository.
# Grain bridge: run `clojure -M -m awp-v2.live.main` from impl/.
AWP_TASKING_STORAGE_DIR=/private/path/to/tasking-data
AWP_SESSION_STORAGE_DIR=/private/path/to/session-data
AWP_GRAIN_SESSION_PORT=9447
AWP_GRAIN_SESSION_TOKEN=

# Pi voice: run `pnpm --dir impl/runtime run build`, then launch
# products/voice-agent/apps/pi-agent/dist/voice-agent-service.js from impl/runtime.
AWP_GRAIN_SESSION_URL=http://127.0.0.1:9447
AWP_OWNER_IDENTITY=owner@example.test
INFERENCE_BROKER_TOKEN=
PI_VOICE_SERVICE_HOST=127.0.0.1
PI_VOICE_SERVICE_PORT=9446
PI_VOICE_MODEL=
PI_VOICE_CWD=/private/path/to/workspace
PI_VOICE_SESSION_DIR=/private/path/to/voice-sessions
GONDOLIN_BROWSER_ASSETS=/private/path/to/built-gondolin-assets
PI_VOICE_SKILLS_DIR=/private/path/to/skills
GITEA_ENDPOINT_URL=http://127.0.0.1:3001
GITEA_OWNER=
GITEA_TOKEN=
GRAFANA_MCP_SERVER_TOKEN=
GRAFANA_MCP_URL=http://127.0.0.1:8000
WASSETTE_BIN=/private/path/to/wassette
WASSETTE_COMPONENT_DIR=/private/path/to/components
WASSETTE_ENV_FILE=/private/path/to/wassette.env
ARTIFACT_ENDPOINT_URL=http://127.0.0.1:9090
ARTIFACT_BUCKET=agent-artifacts
ARTIFACT_ACCESS_KEY=
ARTIFACT_SECRET_KEY=

# Broker: run its locked Python environment as
# `python -m voice_agent.speech.presentation.http` from apps/broker.
PI_VOICE_SERVICE_URL=http://127.0.0.1:9446
OLLAMA_MODEL=
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
MLX_STT_MODEL=mlx-community/parakeet-tdt-0.6b-v3
MLX_TTS_MODEL=mlx-community/Kokoro-82M-bf16
MLX_TTS_VOICE=af_heart

# Edge: run `python bot.py -t webrtc --host 127.0.0.1 --port 7860`
# from apps/edge in a protected local namespace or configured owner ingress.
EDGE_ALLOWED_USERS=owner@example.test
PIPECAT_ALLOWED_ORIGINS=http://127.0.0.1:7860
INFERENCE_BROKER_BASE_URL=http://127.0.0.1:9443/v1
AGENT_GATEWAY_BASE_URL=http://127.0.0.1:9444/v1
AGENT_GATEWAY_TOKEN=
VOICE_DEFAULT_WORKSPACE=agent-workload-platform
VOICE_LLM_BACKEND=pi

# Opt-in qualification. Use separate credential injection in actual runs.
VOICE_EDGE_URL=http://127.0.0.1:7860
VOICE_GRAIN_URL=http://127.0.0.1:9447
VOICE_GRAIN_TOKEN=
VOICE_ORIGIN=http://127.0.0.1:7860
VOICE_OWNER_IDENTITY=owner@example.test
VOICE_UTTERANCE=Describe the current selected conversation briefly.
VOICE_BROKER_URL=http://127.0.0.1:9443
VOICE_BROKER_TOKEN=
