{
  "uid": "voice-storage-capacity",
  "title": "Storage Capacity",
  "description": "Measured usage of the k3d local-path storage directories. Host free capacity is omitted because the macOS bind mount reports an invalid filesystem size inside k3d.",
  "tags": [
    "awp-v2",
    "storage"
  ],
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "title": "Measured k3d storage used",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "awp_k3d_storage_used_bytes",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Storage scan healthy",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "awp_k3d_storage_scan_success",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Used by storage directory",
      "type": "bargauge",
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "awp_k3d_storage_directory_bytes",
          "refId": "A",
          "legendFormat": "{{namespace}}/{{claim}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Storage usage over time",
      "type": "timeseries",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "awp_k3d_storage_used_bytes",
          "refId": "A",
          "legendFormat": "Total used"
        }
      ]
    }
  ]
}
