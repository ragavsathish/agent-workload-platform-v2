# Copy outside the checkout; mode 0600. Replace every placeholder.
AWP_OWNER_IDENTITY=owner@example.test
AWP_TASKING_STORAGE_DIR=/private/awp-v2-state/tasking
AWP_SESSION_STORAGE_DIR=/private/awp-v2-state/sessions
AWP_GRAIN_SESSION_TOKEN=replace-with-random-secret
AWP_GRAIN_SESSION_PORT=9447
AWP_GRAIN_SESSION_URL=http://127.0.0.1:9447
AWP_ELIGIBLE_WORKSPACES=agent-workload-platform,scratch
AWP_WORKSPACE_MAP_JSON={"agent-workload-platform":"/private/approved-workspace","scratch":"/private/awp-v2-state/incident-scratch"}
AWP_TASK_WORKSPACE_DIR=/private/awp-v2-state/tasking/workspaces
# Optional: trusted installed image paths keyed by declared image and pinned source revision.
AWP_TASK_IMAGE_MAP_JSON={}
AWP_TASK_WORKER_LOG_DIR=/private/awp-v2-state/tasking/worker-logs
AWP_WORKER_CAPACITY=1
PI_VOICE_SERVICE_HOST=127.0.0.1
PI_VOICE_SERVICE_PORT=9446
PI_VOICE_SERVICE_URL=http://127.0.0.1:9446
PI_VOICE_SESSION_DIR=/private/awp-v2-state/pi-sessions
PI_VOICE_CWD=/private/approved-workspace
PI_TASK_SESSION_SOCKET_DIR=/private/awp-v2-state/task-sockets
PI_SESSION_DIR=/private/awp-v2-state/pi-sessions
GONDOLIN_BROWSER_ASSETS=/private/gondolin-assets
WORKER_PI_EXECUTION_MODE=gondolin
INFERENCE_BROKER_TOKEN=replace-with-different-random-secret
INFERENCE_BROKER_PORT=9443
AGENT_GATEWAY_TOKEN=replace-with-third-random-secret
AGENT_GATEWAY_PORT=9444
MLX_STT_MODEL=mlx-community/parakeet-tdt-0.6b-v3
MLX_TTS_MODEL=mlx-community/Kokoro-82M-bf16
PI_MODEL=provider/model
# Optional operational incident poller; configure together to enable it.
AWP_INCIDENT_RULES_FILE=/private/awp-v2-config/stack-alerts.json
AWP_INCIDENT_GRAFANA_PASSWORD_FILE=/private/awp-v2-config/grafana-admin-password
AWP_INCIDENT_ALERTS_URL=http://127.0.0.1:3300/api/prometheus/grafana/api/v1/alerts
AWP_INCIDENT_METRICS_URL=http://127.0.0.1:9091
AWP_INCIDENT_WORKSPACE=scratch
AWP_INCIDENT_STORAGE_DIR=/private/awp-v2-state/incidents
