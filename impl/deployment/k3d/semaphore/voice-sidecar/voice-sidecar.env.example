# Non-secret runtime overlay. Semaphore copies this file with mode 0600.
# The helper inherits host runtime settings in memory and reads current owner,
# Grain, and broker credentials from k3d Secrets. It bootstraps the local Gitea
# owner, scoped token, and private workspace repository when they are absent.
AWP_NATIVE_PROFILE=voice-sidecar
AWP_DEPLOYMENT_LEVEL=voice
PI_VOICE_SERVICE_HOST=127.0.0.1
PI_VOICE_SERVICE_PORT=9556
INFERENCE_BROKER_PORT=9553
PI_VOICE_SESSION_DIR=/private/tmp/awp-v2-state/voice-sidecar/pi-sessions
PI_TASK_SESSION_SOCKET_DIR=/private/tmp/awp-v2-state/voice-sidecar/task-sockets
AWP_GRAIN_FORWARD_PORT=19447
AWP_GITEA_FORWARD_PORT=13001
AWP_S3MOCK_FORWARD_PORT=19090
AWP_OXIGRAPH_FORWARD_PORT=17878
AWP_PROMETHEUS_FORWARD_PORT=19091
AWP_OTEL_FORWARD_PORT=14318
AWP_GRAFANA_MCP_FORWARD_PORT=18000
AWP_GRAFANA_MCP_HEALTH_FORWARD_PORT=18080
